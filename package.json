  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:e2e": "bash tests/e2e/run.sh",
