  "devDependencies": {
    "@types/cron": "^1.7.3",
    "@types/fs-extra": "^11.0.4",
    "@types/gm": "^1.25.4",
    "@types/node": "^16.18.126",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^5.9.3",
    "vite": "^4.5.14",
    "vitest": "^0.34.6"
  }
